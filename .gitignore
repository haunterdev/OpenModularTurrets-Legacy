# Datagen and the Forge run configs write logs beside each module. They are
# build output, not source, and dirty the tree on every runData.
logs/

# Datagen writes a hash cache beside the generated resources. The generated
# resources themselves are committed, because they ship inside the jar.
**/src/generated/resources/.cache/

